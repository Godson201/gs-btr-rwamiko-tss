# Database
DATABASE_URL="postgresql://username:password@localhost:5433/gs_btr_rwamiko"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Email. Use Brevo's HTTPS API on Render (free Render services block SMTP ports).
MAIL_ENABLED=true
MAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM_EMAIL=your_verified_sender@gmail.com
MAIL_FROM_NAME=G.S BTR RWAMIKO TSS

# SMTP fallback for local development or hosts that allow SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@gsbtrrwamiko.rw

# Security
BCRYPT_SALT_ROUNDS=10

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload (bytes) - 20MB, applies to announcement/message attachments
MAX_FILE_SIZE=20971520
UPLOAD_PATH=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000
