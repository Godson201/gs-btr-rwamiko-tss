generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== Auth / Users ====================

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
  SUPER_ADMIN
}

enum PermissionScopeMode {
  SCHOOL
  SELF
  TEACHING_ASSIGNMENT
  CLASS_MASTER
  DEPARTMENT
}

enum SchoolRoleAssignmentSource {
  MANUAL
  LEGACY_STAFF_TITLE
  LEGACY_PORTAL_ROLE
  LEGACY_CLASS_MASTER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum ModuleType {
  SPECIFIC
  GENERAL
  COMPLEMENTARY
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  middleName String?
  phone     String?   @unique
  role      Role      @default(STUDENT)
  avatar    String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  nickname            String?
  jobTitle            String?
  dateOfBirth         DateTime?
  accountStatus       AccountStatus @default(ACTIVE)
  portalAccess        Role[]        @default([])
  residenceLocationId String?
  workplaceLocationId String?

  student               Student?
  teacher               Teacher?
  parent                Parent?
  admin                 Admin?
  notifications         Notification[]
  auditLogs             AuditLog[]
  announcements         Announcement[]
  passwordResetTokens   PasswordResetToken[]
  announcementComments  AnnouncementComment[]
  announcementReactions AnnouncementReaction[]
  conversation          Conversation?
  sentMessages          Message[]
  schoolRoleAssignments UserSchoolRole[]       @relation("SchoolRoleAssignee")
  schoolRolesAssigned   UserSchoolRole[]       @relation("SchoolRoleAssigner")
  residenceLocation     Location? @relation("ResidenceLocation", fields: [residenceLocationId], references: [id])
  workplaceLocation     Location? @relation("WorkplaceLocation", fields: [workplaceLocationId], references: [id])

  @@index([role])
}

model Location {
  id       String @id
  province String
  district String
  sector   String
  cell     String
  village  String

  residentsAt User[] @relation("ResidenceLocation")
  workersAt   User[] @relation("WorkplaceLocation")

  @@unique([province, district, sector, cell, village])
  @@index([province, district, sector, cell])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Student {
  id             String    @id @default(cuid())
  userId         String    @unique
  admissionNo    String    @unique
  nationalId     String?   @unique
  dateOfBirth    DateTime
  gender         Gender
  address        String?
  enrollmentDate DateTime  @default(now())
  academicYear   String
  classId        String?
  parentId       String?
  isGraduated    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class?        @relation(fields: [classId], references: [id])
  parent      Parent?       @relation("ParentOfStudent", fields: [parentId], references: [id])
  requestedByParents Parent[] @relation("RequestedStudent")
  attendances Attendance[]
  examResults ExamResult[]
  submissions AssignmentSubmission[]
  disciplinary Disciplinary[]

  @@index([classId])
  @@index([parentId])
}

enum StaffTitle {
  HEAD_TEACHER
  DIRECTOR_OF_STUDIES
  DIRECTOR_OF_DISCIPLINE
  PATRON
  MATRON
}

model Teacher {
  id             String      @id @default(cuid())
  userId         String      @unique
  employeeNo     String      @unique
  nationalId     String?     @unique
  dateOfBirth    DateTime
  gender         Gender
  qualification  String?
  specialization String?
  staffTitle     StaffTitle?
  worksAtAnotherSchool Boolean @default(false)
  otherSchoolName      String?
  hireDate       DateTime    @default(now())
  departmentId   String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?      @relation(fields: [departmentId], references: [id])
  subjects      SubjectTeacher[]
  classes       ClassTeacher[]
  classSubjects ClassSubject[]
  exams         Exam[]
  assignments   Assignment[]
  timetables    Timetable[]
  messages      ParentMessage[]

  @@index([departmentId])
}

enum ParentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Parent {
  id               String   @id @default(cuid())
  userId           String   @unique
  occupation       String?
  address          String?
  relationship     String?
  emergencyContact String?
  status             ParentStatus @default(PENDING)
  requestedStudentId String?
  claimedStudentName String?
  claimedAdmissionNo String?
  approvedAt          DateTime?
  approvedById         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students         Student[]       @relation("ParentOfStudent")
  requestedStudent Student?        @relation("RequestedStudent", fields: [requestedStudentId], references: [id])
  messages         ParentMessage[]
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  position    String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// School-management responsibilities are separate from the legacy Role enum,
// which continues to control portal access during the compatibility period.
model SchoolRole {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions SchoolRolePermission[]
  assignments UserSchoolRole[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles SchoolRolePermission[]
}

model SchoolRolePermission {
  schoolRoleId String
  permissionId String
  scopeMode    PermissionScopeMode
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  schoolRole SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([schoolRoleId, permissionId])
  @@index([permissionId])
}

model UserSchoolRole {
  id           String                     @id @default(cuid())
  userId       String
  schoolRoleId String
  assignedById String?
  assignedAt   DateTime                   @default(now())
  source       SchoolRoleAssignmentSource @default(MANUAL)
  isActive     Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  user             User                       @relation("SchoolRoleAssignee", fields: [userId], references: [id], onDelete: Cascade)
  schoolRole       SchoolRole                 @relation(fields: [schoolRoleId], references: [id], onDelete: Restrict)
  assignedBy       User?                      @relation("SchoolRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  departmentScopes UserSchoolRoleDepartment[]

  @@unique([userId, schoolRoleId])
  @@index([schoolRoleId])
  @@index([assignedById])
}

model UserSchoolRoleDepartment {
  userSchoolRoleId String
  departmentId     String
  createdAt        DateTime @default(now())

  userSchoolRole UserSchoolRole @relation(fields: [userSchoolRoleId], references: [id], onDelete: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userSchoolRoleId, departmentId])
  @@index([departmentId])
}

// ==================== Academic Structure ====================

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms   Term[]
  classes Class[]
}

model Term {
  id             String   @id @default(cuid())
  name           String
  academicYearId String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams        Exam[]

  @@index([academicYearId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teachers Teacher[]
  subjects Subject[]
  classes  Class[]
  schoolRoleScopes UserSchoolRoleDepartment[]
}

model Class {
  id             String   @id @default(cuid())
  name           String
  level          String
  section        String?
  academicYearId String
  departmentId   String?
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  students     Student[]
  teachers     ClassTeacher[]
  subjects     ClassSubject[]
  timetables   Timetable[]
  attendances  Attendance[]
  exams        Exam[]
  assignments  Assignment[]

  @@unique([name, section, academicYearId])
  @@index([academicYearId])
  @@index([departmentId])
}

model Subject {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  departmentId  String?
  description   String?
  credits       Int?
  learningHours Int?
  sector        String?
  moduleType    ModuleType?
  competences   String[]
  isCore        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department  Department?      @relation(fields: [departmentId], references: [id])
  teachers    SubjectTeacher[]
  classes     ClassSubject[]
  exams       Exam[]
  assignments Assignment[]
  timetables  Timetable[]

  @@index([departmentId])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
}

model ClassTeacher {
  id            String   @id @default(cuid())
  classId       String
  teacherId     String
  isClassMaster Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
}

model SubjectTeacher {
  id        String   @id @default(cuid())
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
}

// ==================== Timetable / Attendance ====================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id        String    @id @default(cuid())
  classId   String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  subjectId String
  teacherId String?
  room      String?
  term      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@index([classId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime         @default(now())
  status    AttendanceStatus
  reason    String?
  markedBy  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, date])
  @@index([classId, date])
}

// ==================== Exams / Results ====================

enum ExamType {
  CAT1
  CAT2
  END_TERM
  MID_TERM
  FINAL
  CONTINUOUS_ASSESSMENT
}

model Exam {
  id          String   @id @default(cuid())
  name        String
  type        ExamType
  termId      String
  subjectId   String
  classId     String
  teacherId   String?
  date        DateTime
  maxMarks    Int
  passMarks   Int
  duration    Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  term    Term         @relation(fields: [termId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  class   Class        @relation(fields: [classId], references: [id])
  teacher Teacher?     @relation(fields: [teacherId], references: [id])
  results ExamResult[]

  @@index([classId, termId])
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  marks     Float
  grade     String?
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

// ==================== Assignments ====================

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  subjectId   String
  teacherId   String
  classId     String
  dueDate     DateTime
  maxMarks    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject                @relation(fields: [subjectId], references: [id])
  teacher     Teacher                @relation(fields: [teacherId], references: [id])
  class       Class                  @relation(fields: [classId], references: [id])
  submissions AssignmentSubmission[]

  @@index([classId])
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  LATE
  RESUBMITTED
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  submissionDate DateTime         @default(now())
  fileUrl        String?
  marks          Float?
  feedback       String?
  status         SubmissionStatus @default(SUBMITTED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// ==================== Communication ====================

enum AnnouncementType {
  GENERAL
  ACADEMIC
  FEES_FINANCE
  REGISTRATION
  EVENT_ACTIVITY
  DISCIPLINE
  SAFETY_ALERT
  EMERGENCY
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

model Announcement {
  id             String           @id @default(cuid())
  title          String
  content        String
  type           AnnouncementType
  targetAudience Role[]
  authorId       String
  isPublished    Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  isPublic       Boolean          @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  author        User                     @relation(fields: [authorId], references: [id])
  notifications Notification[]
  attachments   AnnouncementAttachment[]
  comments      AnnouncementComment[]
  reactions     AnnouncementReaction[]
}

model AnnouncementAttachment {
  id             String         @id @default(cuid())
  announcementId String
  url            String
  type           AttachmentType
  filename       String
  data           Bytes?
  mimeType       String?
  createdAt      DateTime       @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model AnnouncementComment {
  id             String   @id @default(cuid())
  announcementId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  type           ReactionType
  createdAt      DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  REMINDER
}

model Notification {
  id             String            @id @default(cuid())
  userId         String
  title          String
  content        String
  type           NotificationType
  isRead         Boolean           @default(false)
  link           String?
  announcementId String?
  createdAt      DateTime          @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id])

  @@index([userId, isRead])
}

model Disciplinary {
  id           String    @id @default(cuid())
  studentId    String
  incidentDate DateTime
  description  String
  action       String
  actionDate   DateTime?
  recordedBy   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ParentMessage {
  id        String   @id @default(cuid())
  parentId  String
  teacherId String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

model Conversation {
  id        String             @id @default(cuid())
  userId    String             @unique
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId])
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  url       String
  type      AttachmentType
  filename  String
  mimeType  String?
  data      Bytes?
  createdAt DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ==================== System ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorName  String?
  actorEmail String?
  actorRole  String?
  action     String
  method     String?
  resource   String?
  resourceId String?
  statusCode Int?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt, id])
  @@index([resource, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== Admissions ====================

enum AdmissionApplicantType {
  STUDENT
  PARENT
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model AdmissionApplication {
  id                   String                 @id @default(cuid())
  applicationNo        String                 @unique
  applicantType        AdmissionApplicantType
  studentFirstName     String
  studentLastName      String
  studentDateOfBirth   DateTime
  studentGender        Gender
  previousSchool       String
  previousSchoolLocation String
  transferReason       String
  averageMarks         Float
  applyingLevel        String
  preferredProgramme   String
  guardianFirstName    String
  guardianLastName     String
  guardianRelationship String
  guardianEmail        String
  guardianPhone        String
  residence            String
  resultDocumentUrl    String
  resultDocumentName   String
  profilePictureUrl    String
  profilePictureName   String
  notes                String
  status               AdmissionStatus        @default(PENDING)
  reviewedById         String?
  reviewNotes          String?
  reviewedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([guardianEmail])
}
